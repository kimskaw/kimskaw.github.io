        </mxCell>
        <mxCell id="tar" value="config backup .tar.gz&#10;/mnt/external/backups" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="590" y="470" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- storage note -->
        <mxCell id="storage" value="Storage: external WD drive (NTFS), auto-mounted by UUID at /mnt/external. Holds downloads + Movies/Shows. App config + DBs on the Pi SSD." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="230" height="90" as="geometry" />
        </mxCell>

        <!-- access note -->
        <mxCell id="net" value="LAN / Tailscale only — 0 ports exposed to the internet" style="text;html=1;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="320" y="880" width="300" height="20" as="geometry" />
