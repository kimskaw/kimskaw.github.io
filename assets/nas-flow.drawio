        <mxCell id="e6" value="path-mapped" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="dl" target="imp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="imp" target="lib"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="scan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="lib" target="jf"><mxGeometry relative="1" as="geometry" /></mxCell>
