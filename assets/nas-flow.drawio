<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="NAS media flow" id="nasflow01">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Raspberry Pi Media Stack — request to playback" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="420" height="30" as="geometry" />
        </mxCell>

        <!-- main pipeline -->
        <mxCell id="u" value="User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="70" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="js" value="Jellyseerr&#10;(request UI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="150" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sr" value="Sonarr / Radarr&#10;(TV / movie automation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="320" y="230" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pr" value="Prowlarr&#10;(indexer search)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="320" y="310" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="qb" value="qBittorrent&#10;(download client)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
