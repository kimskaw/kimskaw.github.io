        <!-- edges main -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="u" target="js"><mxGeometry relative="1" as="geometry" /></mxCell>
