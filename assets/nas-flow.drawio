        <!-- edges branches -->
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="dz" target="ing"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="manual uploads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="ing" target="lib"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="subtitles" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="bz" target="lib"><mxGeometry relative="1" as="geometry" /></mxCell>
